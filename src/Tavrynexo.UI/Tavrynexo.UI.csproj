<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>Tavrynexo.UI.App</StartupObject>
    <Company>Tavrynexo Software</Company>
    <Product>Tavrynexo Uninstaller</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tavrynexo.Core\Tavrynexo.Core.csproj" />
    <ProjectReference Include="..\Tavrynexo.Engine\Tavrynexo.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
</Project>
