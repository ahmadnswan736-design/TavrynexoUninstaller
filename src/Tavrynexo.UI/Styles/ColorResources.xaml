<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="TnBrandAccentColor">#0078D4</Color>
    <Color x:Key="TnDangerColor">#E81123</Color>
    <Color x:Key="TnSuccessColor">#107C41</Color>
    <Color x:Key="TnWarningColor">#D83B01</Color>

    <SolidColorBrush x:Key="TnBrandAccentBrush" Color="{StaticResource TnBrandAccentColor}" />
    <SolidColorBrush x:Key="TnDangerBrush" Color="{StaticResource TnDangerColor}" />
    <SolidColorBrush x:Key="TnSuccessBrush" Color="{StaticResource TnSuccessColor}" />
    <SolidColorBrush x:Key="TnWarningBrush" Color="{StaticResource TnWarningColor}" />

    <SolidColorBrush x:Key="TnSurfaceBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TnCardBrush" Color="#282828" />
    <SolidColorBrush x:Key="TnBorderBrush" Color="#383838" />
</ResourceDictionary>
